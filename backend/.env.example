# Copy to backend/.env and fill in real values before deploying.

# --- Core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=true
ENV=development

# --- Database (matches docker-compose.yml defaults) ---
DATABASE_URL=postgresql+asyncpg://mallens:mallens_pass@db:5432/mallens_db

# --- Queue ---
REDIS_URL=redis://redis:6379/0

# --- Storage ---
UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=100
RETENTION_DAYS=30

# --- Auth (leave REQUIRE_AUTH=false for a quick local demo) ---
REQUIRE_AUTH=false
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- Dynamic sandbox ---
# "stub" (default, no infra needed, sample is never executed) or "cuckoo"
DYNAMIC_SANDBOX_PROVIDER=stub
CUCKOO_API_URL=
CUCKOO_API_TOKEN=
DYNAMIC_ANALYSIS_TIMEOUT_SECONDS=180

# --- Threat intel (optional) ---
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# --- AI report summaries (optional) ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- CORS ---
CORS_ORIGINS=http://localhost:3000
